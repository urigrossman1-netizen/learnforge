{
  "enabledMcpjsonServers": [
    "youtube",
    "spotify"
  ],
  "permissions": {
    "allow": [
      "Bash(drum-agent:*)",
      "Bash(bin/drum-agent:*)",
      "Bash(uv run drum-agent:*)",
      "mcp__youtube__ytdlp_search_videos",
      "mcp__youtube__ytdlp_get_video_metadata_summary",
      "mcp__youtube__ytdlp_get_video_metadata",
      "mcp__spotify__search",
      "mcp__spotify__get_track",
      "Read(/charts/**)",
      "Edit(/charts/**)",
      "Write(/charts/**)"
    ],
    "deny": [
      "Read(/.env)",
      "Edit(/.env)",
      "Read(~/.config/drum-agent/**)",
      "Edit(~/.config/drum-agent/**)",
      "Read(~/.spotify-mcp/**)"
    ]
  }
}
